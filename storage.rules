rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Owners can read, list and delete anything in their own tree, so account
    // deletion can clear whatever is there, including objects older clients
    // wrote at other paths.
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
    }

    // Uploads only at the one path the app writes
    // (SyncService.photoStoragePath), as a JPEG under 10 MiB. The app's
    // re-encodes produce well under that; the cap only stops a client using
    // the shared Spark quota for anything else.
    match /users/{userId}/photos/{pieceId}/{photoFile} {
      allow create, update: if isOwner(userId)
        && photoFile.matches('[^/]+[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
