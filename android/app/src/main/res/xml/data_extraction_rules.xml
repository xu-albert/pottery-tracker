<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup configuration. Every domain the backup agent walks is
     excluded from both operations, so neither a cloud backup nor a
     device-to-device transfer carries the encrypted database (app_flutter/) or
     the plugin's key store (shared_prefs/) to another phone. An <exclude> with
     no path names the domain's whole directory. The domains are the set
     FullBackup.getDirectoryForCriteriaDomain accepts;
     test/android/data_extraction_rules_test.dart pins that none is dropped. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
