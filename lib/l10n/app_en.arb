  "recoveryTitle": "This phone can't open your pottery journal",
  "@recoveryTitle": { "description": "Title of the screen shown before the app when a database file is present but no key on this device opens it" },
  "recoveryMessageKeyMissing": "Your journal was restored from a backup, but the key that unlocks it stays on the phone it was made on and is never included in backups. That protects your pottery if a backup is ever copied — and it means this phone can't read the restored copy on its own.",
  "@recoveryMessageKeyMissing": { "description": "Recovery explanation when no database key is stored on this device: the backup-restore case" },
  "recoveryMessageKeyMissingAndroid": "The key that unlocks this journal is held in this phone's secure hardware and never leaves it, so it is never included in a backup or a phone-to-phone transfer. This phone can no longer read that key, so the journal stored here can't be opened on its own.",
  "@recoveryMessageKeyMissingAndroid": { "description": "Recovery explanation when no database key is readable on Android, where the app is excluded from backups and device transfer so nothing was restored: the key itself became unreadable" },
  "recoveryMessageKeyMismatch": "The journal on this phone was encrypted with a key this phone no longer has, so it can't be read on its own.",
  "@recoveryMessageKeyMismatch": { "description": "Recovery explanation when a key is stored but does not decrypt the database" },
  "recoveryCloudHint": "This journal was backed up to an account. Sign in with it and your pieces are downloaded again; the photos already on this phone are kept. Changes the old phone never finished backing up are lost.",
  "@recoveryCloudHint": { "description": "Recovery hint when the restored preferences name a synced account: the pieces can be downloaded again, but edits the old phone never pushed are not in the cloud" },
  "recoveryLocalOnlyHint": "This journal was kept on the old phone only and never signed in, so there is no cloud copy to download. Without its transfer passphrase, its pieces can't be recovered here.",
  "@recoveryLocalOnlyHint": { "description": "Recovery hint when no synced account is recorded: the data existed on the old phone only" },
  "recoveryLocalOnlyHintAndroid": "This journal was never signed in, so there is no cloud copy to download. Pottery kept on this phone alone can't be recovered without its key.",
  "@recoveryLocalOnlyHintAndroid": { "description": "Recovery hint on Android when no synced account is recorded. Says the same thing without offering the transfer passphrase, which Android does not have — see the Settings tile, which is iOS-only" },
